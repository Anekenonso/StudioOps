# StudioOps backend configuration. Copy to .env for local use.
# NEVER commit the filled-in .env — it is git-ignored. Supply the same values
# via Secret Manager in production. No key here ever reaches the browser.

# --- Parallel Search API ----------------------------------------------------
PARALLEL_API_KEY=
# Override only if your Parallel contract uses a different host.
PARALLEL_BASE_URL=https://api.parallel.ai

# --- Gemini: option A, Vertex AI (Google Cloud service account) -------------
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Path to the service-account JSON...
GOOGLE_APPLICATION_CREDENTIALS=
# ...or provide the full JSON as a string (CI / Secret Manager). If set, it is
# written to disk and GOOGLE_APPLICATION_CREDENTIALS is wired automatically.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Gemini: option B, Developer API (API key) ------------------------------
# Use instead of Vertex. Leave GOOGLE_GENAI_USE_VERTEXAI unset/false.
GEMINI_API_KEY=

# Model id (defaults to gemini-2.5-flash).
GEMINI_MODEL=

# --- Server -----------------------------------------------------------------
# Comma-separated allowed origins in production, e.g. the frontend Cloud Run URL.
CORS_ALLOW_ORIGINS=
LOG_LEVEL=INFO
