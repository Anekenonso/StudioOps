# --- Frontend configuration -------------------------------------------------
# Copy to .env.local. No secrets belong in this file: every value here is
# shipped to the browser or used only to proxy requests.

# Where the FastAPI backend runs. Used by the Next dev/prod server to proxy
# /api and /reports, so the browser talks to a single origin.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Set this instead when the browser should call the backend directly
# (e.g. a Cloud Run URL). When set, the proxy above is disabled.
# NEXT_PUBLIC_API_BASE_URL=https://studioops-api-xxxxxxx.a.run.app
